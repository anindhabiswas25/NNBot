{
  "name": "nodeneuron-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "NodeNeuron — AI + crypto research, distilled 4× a day (Telegram bot)",
  "scripts": {
    "dev": "wrangler dev --local",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply nodeneuron --local",
    "db:migrate": "wrangler d1 migrations apply nodeneuron --remote",
    "poll": "tsx scripts/poll.ts",
    "job": "tsx src/job/run.ts",
    "setup:telegram": "tsx scripts/setup-telegram.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261119.1",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "fast-xml-parser": "^4.5.0"
  }
}
